#include <iostream>
#include <string>
#include <thread>
#include <chrono>
#include <random>
#include <sstream>
#include <iomanip>

int main() {
    std::random_device rd;
    std::mt19937 rng(rd());
    std::uniform_int_distribution<int> distID(1, 99999);
    std::uniform_int_distribution<int> distDelay(2, 5);

    while (true) {
        int numero = distID(rng);

        std::ostringstream oss;
        oss << "PX-" << std::setw(5) << std::setfill('0') << numero;
        std::string id = oss.str();

        std::cout << "Enviando: " << id << "\n";

        int delay = distDelay(rng);
        std::this_thread::sleep_for(std::chrono::seconds(delay));
    }
    return 0;
}