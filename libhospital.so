# Paso 1: Generar puentes C++ y Python mediante SWIG
swig -python -c++ hospital_server.i

# Paso 2: Compilar lógica del negocio con banderas de posición de memoria independiente
g++ -O3 -fPIC -std=c++17 -c hospital_server.cpp

# Paso 3: Compilar el Wrapper generado por SWIG enlazando las librerías dinámicas de Python
# (Ajusta el path de tu versión de Python si es necesario, ej: python3.11, python3.12)
g++ -O3 -fPIC -std=c++17 -c hospital_server_wrap.cxx -I/usr/include/python3.10

# Paso 4: Construir la librería compartida final vinculando ambos objetos
g++ -shared hospital_server.o hospital_server_wrap.o -o _hospital_server.so